#!/usr/bin/python3 -I
"""ZENOS: the dpkg apt runs (Dir::Bin::dpkg). apt's pre-install check looks at the package files before dpkg starts;
dpkg reads them later, maybe minutes later in a long upgrade, from a folder another program could write to. This
wrapper copies every package file into a root-only folder, checks the copy against the release ledger (the SHA-256
of exactly what dpkg will read: allowed by the pre-install check moments ago, or decided again here), and gives dpkg
the copies. Every file argument counts as a package, whatever its name; -R (a whole folder) is refused. Anything
else is passed to /usr/bin/dpkg unchanged. With /etc/zenos/supply.json absent or "off" it only
passes everything through.
"""
import os, shutil, subprocess, sys, tempfile
sys.path.insert(0, "/usr/lib/zenos")
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

DPKG = os.environ.get("ZENOS_REAL_DPKG", "/usr/bin/dpkg")
STAGE = os.environ.get("ZENOS_DPKG_STAGE", "/var/lib/zenos/dpkg-stage")


def main(argv):
    try:
        import zsupply
        c = zsupply.conf()
    except Exception:
        c = {"mode": "enforce", "broken": True}
    if c.get("mode", "off") == "off":
        os.execv(DPKG, [DPKG] + argv)
    # dpkg installs any file it is given, whatever its name, and every package in a folder with -R: so every file
    # argument is a package to check (not only *.deb), and a folder install is refused while the check is on
    if any(a in ("-R", "--recursive") or (a.startswith("-") and not a.startswith("--") and "R" in a[1:] and
                                           all(ch.isalpha() for ch in a[1:])) for a in argv):
        print("ZENOS: installing every package in a folder (-R) is not allowed; give the package files.", file=sys.stderr)
        return 2
    debs = [i for i, a in enumerate(argv) if not a.startswith("-") and os.path.isfile(a)]
    if not debs:
        os.execv(DPKG, [DPKG] + argv)
    import zenos_pkgcheck as P
    os.makedirs(STAGE, mode=0o700, exist_ok=True)
    os.chmod(STAGE, 0o700)
    d = tempfile.mkdtemp(dir=STAGE)
    try:
        args = list(argv)
        refused = []
        for i in debs:
            src = argv[i]
            dst = os.path.join(d, "%03d-%s" % (i, os.path.basename(src)))
            with open(src, "rb") as fi, open(dst, "xb") as fo:
                shutil.copyfileobj(fi, fo)
            os.chmod(dst, 0o400)
            sha = zsupply.sha256_file(dst)
            if not P.allowed_recently(sha):
                if P.check([dst], c) != 0:
                    refused.append(os.path.basename(src))
            args[i] = dst
        if refused and c.get("mode") == "enforce":
            print("ZENOS: not installing %s: not in the release ledger as required." % ", ".join(refused), file=sys.stderr)
            return 2
        return subprocess.run([DPKG] + args, close_fds=False).returncode
    finally:
        shutil.rmtree(d, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
