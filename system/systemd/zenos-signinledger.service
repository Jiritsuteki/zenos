[Unit]
Description=ZENOS sign-ins to the PC in the tamper-evident ledger (sign-in, sign-out, failed password, lock)
After=systemd-journald.service systemd-logind.service
[Service]
ExecStart=/usr/bin/python3 -I /usr/sbin/zenos_signinledger.py
Restart=always
RestartSec=2
[Install]
WantedBy=multi-user.target
